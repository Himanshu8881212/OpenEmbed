# EMBEd configuration — copy to .env and edit.

# ── Auth ────────────────────────────────────────────────
# Required in production. Without this, admin routes (create/list/delete vaults)
# and any vault that lacks its own key are UNAUTHENTICATED — the server logs a
# loud warning at startup. Set this to a long random string before deploying.
ADMIN_API_KEY=

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Perception Encoder (multimodal embedding stack) ─────
# PE-Core handles text + images; PE-AV handles audio + video.
# Embedding dim is fixed at 1024 across all modalities.
PE_CORE_MODEL=PE-Core-L14-336
PE_AV_MODEL=facebook/pe-av-large
EMBEDDING_DIMENSIONS=1024
PE_DTYPE=float16
# PE_AV_LAZY=true defers loading PE-AV until first audio/video request (saves ~3GB RAM at boot)
PE_AV_LAZY=false
PE_COMPILE=false

# ── Storage ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_PATH=./embed.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100000000

# ── Chunking ────────────────────────────────────────────
# ~150 ModernBERT tokens at chunk_size=600 chars
CHUNK_SIZE=600

# ── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_EMBED=30/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_STORES=10/minute
