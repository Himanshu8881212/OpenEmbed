# Application Settings
APP_NAME=EMBEd - Multi-Modal Embedding Application
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Model Configuration
CACHE_DIR=./cache_dir
MODEL_CACHE_DIR=./model_cache
DEVICE=cuda:0

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Upload Configuration
MAX_FILE_SIZE=500000000  # 500MB
UPLOAD_DIR=./uploads
ALLOWED_VIDEO_FORMATS=.mp4,.avi,.mov,.mkv
ALLOWED_AUDIO_FORMATS=.wav,.mp3,.flac,.m4a
ALLOWED_IMAGE_FORMATS=.jpg,.jpeg,.png,.bmp
ALLOWED_DEPTH_FORMATS=.png,.npy
ALLOWED_THERMAL_FORMATS=.jpg,.jpeg,.png

# Security
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
