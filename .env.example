# Local development values only (match docker-compose defaults). Never commit real secrets.
KB_DATABASE_URL=postgres://kb_api:dev-api@127.0.0.1:54329/kb
KB_WORKER_DATABASE_URL=postgres://kb_worker:dev-worker@127.0.0.1:54329/kb
KB_MIGRATE_DATABASE_URL=postgres://kb_owner:dev-owner@127.0.0.1:54329/kb
KB_S3_ENDPOINT=http://127.0.0.1:8333
KB_S3_REGION=us-east-1
KB_S3_BUCKET=kb-data
KB_S3_ACCESS_KEY=kbdevaccess
KB_S3_SECRET_KEY=kbdevsecret
KB_OIDC_ISSUER=http://localhost:8180/realms/kb
KB_OIDC_CLI_CLIENT_ID=kb-cli
KB_OIDC_ALLOWED_CLIENTS=kb-cli,kb-web,kb-test
KB_INFERENCE_URL=http://127.0.0.1:8100
KB_INFERENCE_TOKEN=dev-inference-token
KB_INFERENCE_DEVICE=auto
KB_INFERENCE_DTYPE=float32
KB_PUBLIC_BASE_URL=http://localhost:3000
# Default plan for new workspaces: hard caps (no excess charges). Values are dev allowances, not commercial terms.
KB_DEFAULT_PLAN='{"name":"dev","allow_excess":false,"limits":{"storage_bytes":10737418240,"index_tokens_month":50000000,"query_tokens_month":5000000}}'
KB_RETENTION_SECONDS=0
KB_CONNECTOR_ALLOWED_HOSTS=127.0.0.1:8765
NEXT_PUBLIC_KB_OIDC_ISSUER=http://localhost:8180/realms/kb
NEXT_PUBLIC_KB_OIDC_WEB_CLIENT_ID=kb-web
KB_RATE_LIMIT_PER_MINUTE=600
KB_METRICS_TOKEN=dev-metrics-token
KB_DEFAULT_PROFILE=eg2-914f7f8-fp32-p4
