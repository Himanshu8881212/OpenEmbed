    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "title": "Firing alerts",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 7,
   "title": "API requests / s by status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(kb_http_requests_total[5m]))",
     "legendFormat": "{{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "API p95 latency by route",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(6, histogram_quantile(0.95, sum by (le, route) (rate(kb_http_request_duration_seconds_bucket[5m]))))",
     "legendFormat": "{{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Inference inputs / s by modality",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (modality) (rate(kb_inference_inputs_total[5m]))",
     "legendFormat": "{{modality}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "title": "Inference p95 seconds by modality",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, modality) (rate(kb_inference_seconds_bucket[5m])))",
     "legendFormat": "{{modality}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Inference saturation",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg_over_time(kb_inference_busy[5m])",
     "legendFormat": "busy (0-1)"
    },
    {
     "refId": "B",
     "expr": "kb_inference_waiting",
     "legendFormat": "waiting requests"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
